<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="เว็บไซต์แสดงผลงานและทักษะของ napipuk">
    <title>ความภาคภูมิใจของ NAPIPUK</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- ส่วนหัวของเว็บ -->
    <header>
        <h1>สวัสดี! ผมคือ NAPIPUK</h1>
        <p>นี่คือผลงานและความภาคภูมิใจของหนู</p>
    </header>

    <!-- ส่วนเกี่ยวกับตัวเอง -->
    <section id="about">
        <h2>เกี่ยวกับหนู</h2>
        <p>หนูชอบเล่นกีฬา เป็นคนรักสัตว์ เเละชอบกินช็อคโกเเลต</p>
    </section>

    <!-- ส่วนแสดงผลงาน -->
    <section id="projects">
        <h2>ผลงานของผม</h2>

        <div class="project">
            <h3>เว็บไซต์ Portfolio</h3>
            <p>เว็บไซต์นี้เป็นหนึ่งในผลงานที่ผมสร้างขึ้นเพื่อแสดงความสามารถของหนู</p>
        </div>

        <div class="project">
            <h3>แอปพลิเคชันจัดการงาน</h3>
            <p>แอปพลิเคชันที่ช่วยให้ผู้ใช้งานจัดการงานได้อย่างมีประสิทธิภาพ</p>
        </div>
    </section>

    <!-- ส่วนแสดงทักษะ -->
    <section id="skills">
        <h2>ทักษะของหนู</h2>
        <ul>
            <li>HTML, CSS, JavaScript</li>
            <li>Python, Django</li>
            <li>Git และ GitHub</li>
            <li> UI/UXเล่นกีฬาเก่ง</li>
        </ul>
    </section>

    <!-- ส่วนติดต่อและลิขสิทธิ์ -->
    <footer>
        <p>ติดต่อผมได้:
            <a href="mailto:napipukkrawpan@gmail.com">napipukkrawpan@gmail.com</a>
        </p>
        <p>&copy; <span id="year"></span> SOMCHAI. All rights reserved. </p>
    </footer>

    <!-- ลิงก์ไปยัง JavaScript -->
    <script src="script.js"></script>

</body>
</html>
